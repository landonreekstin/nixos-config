// ~/nixos-config/modules/nixos/profiles/vr-srgb-fix/decode.comp
// sRGB -> linear over the raw bytes of an eye image (see layer.c).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform image2DArray img;

vec3 decode(vec3 c) {
  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

void main() {
  ivec3 p = ivec3(gl_GlobalInvocationID);
  if (any(greaterThanEqual(p.xy, imageSize(img).xy))) return;
  vec4 v = imageLoad(img, p);
  imageStore(img, p, vec4(decode(v.rgb), v.a));
}
