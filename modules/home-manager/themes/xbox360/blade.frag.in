// ~/nixos-config/modules/home-manager/themes/xbox360/blade.frag.in
// The blade surface: the open section's radial gradient, its header and footer
// bands around a rounded content card, the card's concentric sheen and two
// slow ripple rings, and the top-down gloss. The gradient covers the whole
// surface; everything else belongs to the open panel, masked by the same arc
// Geometry.js draws (the @KY@/@KD@ knots are substituted from Config at build
// time, so the two cannot drift).
//
// Coordinates are the shell's reference frame (Geometry.js): `ref` is W x H
// reference units, 1280 x 720 on a 16:9 screen. Works in sRGB with no tone
// mapping, like the console's own art.
#version 440
layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;

layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 res;       // surface size in pixels
    vec2 refSize;   // the reference frame, W x H
    float time;     // seconds, for the ripples
    float panelL;   // panel edges, reference units
    float panelR;
    float curveAmt; // 1 on the dashboard, 0 for the straight app/page frame
    float masked;   // 1: bands/card/sheen/gloss in the panel only; 0: plain surface
    vec4 c0;        // gradient stops at 0 / 30 / 62 / 100 %
    vec4 c1;
    vec4 c2;
    vec4 c3;
    float glow;     // 1 by day; night mode dims the gloss, sheen and ripples
    float hb;       // the panel's header and footer band heights, reference units
    float fh;
    float turned;   // 1: drawn turned a quarter on a portrait screen (Frame.qml),
                    // so "up" for the gloss is along x
};

const int N = @N@;
const float KY[N] = float[N](@KY@);
const float KD[N] = float[N](@KD@);
const float CARD_INSET = @CI@;
const float CARD_RADIUS = @CR@;

// Catmull-Rom through the knots, clamped — identical to Geometry.js curve().
float curve(float y) {
    if (y <= KY[0]) return KD[0];
    if (y >= KY[N - 1]) return KD[N - 1];
    int i = 0;
    for (int j = 0; j < N - 2; j++) { if (y >= KY[j + 1]) i = j + 1; }
    float p0 = KD[max(i - 1, 0)], p1 = KD[i], p2 = KD[i + 1], p3 = KD[min(i + 2, N - 1)];
    float t = (y - KY[i]) / (KY[i + 1] - KY[i]);
    float t2 = t * t, t3 = t2 * t;
    return 0.5 * (2.0 * p1 + (p2 - p0) * t + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2
                  + (3.0 * p1 - p0 - 3.0 * p2 + p3) * t3);
}

float hash(vec2 p) {
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

// One ripple: a 2 px ring scaling 0.35x -> 1.6x on an ease-out, fading as it goes.
float ripple(float rs, float phase, float pxPerUnit, float strength) {
    float e = 1.0 - (1.0 - phase) * (1.0 - phase);
    float radius = mix(0.35, 1.6, e) * 0.5;
    float distPx = abs(rs - radius) * pxPerUnit;
    return strength * (1.0 - phase) * (1.0 - smoothstep(0.0, 1.6, distPx));
}

void main() {
    vec2 px = qt_TexCoord0 * res;
    vec2 ref = qt_TexCoord0 * refSize;
    float H = refSize.y;
    float footerTop = H - fh;

    // radial-gradient(90% 80% at 50% 44%) of the panel.
    float w = max(panelR - panelL, 1.0);
    vec2 centre = vec2((panelL + panelR) * 0.5, 0.44 * H);
    float r = length((ref - centre) / vec2(0.9 * w, 0.8 * H));
    vec3 col;
    if (r < 0.30)      col = mix(c0.rgb, c1.rgb, r / 0.30);
    else if (r < 0.62) col = mix(c1.rgb, c2.rgb, (r - 0.30) / 0.32);
    else               col = mix(c2.rgb, c3.rgb, clamp((r - 0.62) / 0.38, 0.0, 1.0));

    // Inside the open panel? Its left edge is the mirrored curve, its right
    // edge the plain one; the arc always spans the full height.
    float d = curveAmt * curve(ref.y * 720.0 / H);
    float L = panelL - d, R = panelR + d;
    float aa = refSize.x / res.x;
    float inside = 1.0;
    float card = 1.0;
    if (masked > 0.5) {
        inside = smoothstep(L - aa, L + aa, ref.x) * (1.0 - smoothstep(R - aa, R + aa, ref.x));

        // The panel is a darker header band (holding the title) and footer
        // band (the legend) around a lighter, rounded content card whose
        // sides follow the panel's own edges.
        float dx = min(ref.x - (L + CARD_INSET), (R - CARD_INSET) - ref.x);
        float dy = min(ref.y - hb, footerTop - ref.y);
        if (dx < 0.0 || dy < 0.0) {
            card = 1.0 - smoothstep(-aa, aa, max(-dx, -dy));
        } else if (dx < CARD_RADIUS && dy < CARD_RADIUS) {
            float k = length(vec2(CARD_RADIUS - dx, CARD_RADIUS - dy)) - CARD_RADIUS;
            card = 1.0 - smoothstep(-aa, aa, k);
        }
    }

    // Height down the SCREEN, 0 at the top, whichever way the frame is turned.
    float gy = turned > 0.5 ? ref.x / refSize.x : ref.y / H;

    // The bands: the section's deep stops, lighter toward the top.
    vec3 band = mix(c2.rgb, c3.rgb, 0.55 + 0.3 * gy);
    col = mix(band, col, card);

    // Concentric sheen: light and dark rings around the focal point, fading
    // toward the edges; circular in screen pixels whatever the aspect.
    vec2 centrePx = centre / refSize * res;
    float rs = length(px - centrePx) / res.y;
    float sheen = 0.03 * sin(rs * 34.0) * (1.0 - smoothstep(0.15, 0.9, rs));

    // Two ripples half a period apart, 9 s each.
    float rip = ripple(rs, fract(time / 9.0), res.y, 0.30)
              + ripple(rs, fract(time / 9.0 + 0.5), res.y, 0.22);

    col += glow * inside * card * (vec3(sheen) + vec3(rip));

    // Specular gloss: white, 30% at the top -> 5% at 45% -> 0.
    float g = gy < 0.45 ? mix(0.30, 0.05, gy / 0.45)
                        : mix(0.05, 0.0, clamp((gy - 0.45) / 0.25, 0.0, 1.0));
    col = mix(col, vec3(1.0), glow * inside * g * mix(0.5, 1.0, card));

    // Dither away the banding a wide gradient shows.
    col += (hash(px) - 0.5) / 255.0;

    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0) * qt_Opacity;
}
