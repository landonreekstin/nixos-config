# ~/nixos-config/modules/home-manager/themes/glade/colors.nix
#
# The Glade's palette, taken from the scenes in pkgs/glade/src (scenes.py BASE and the
# Glade's sky/mist), so the bar and window chrome read as part of the same world.
{
  ink = "#2e2454";     # the deep indigo the glade uses for text and its cursor outline
  cream = "#fff6e8";
  mist = "#ffdce8";
  light = "#fff8dc";
  pink = "#ff9ed2";
  pink2 = "#ffc4e4";
  leaf = "#5cc4aa";
  leaf2 = "#84dc98";
  leaf3 = "#46a0aa";
  lav = "#a692e8";
  sky = "#92b8ff";
  wood = "#ba7684";
  earth = "#ffd6b2";
  font = "Departure Mono"; # a pixel font, to match the glade's pixels
}
